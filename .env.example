# PostgreSQL connection
DATABASE_URL=postgresql://user:password@localhost:5432/inci_db

# PubMed API identification
NCBI_EMAIL=your_email@example.com
NCBI_TOOL=graph_rag_pipeline
NCBI_API_KEY=

# API request configuration
REQUEST_TIMEOUT=30
REQUEST_SLEEP=0.34                  # NCBI_API_KEY가 있으면 0.11까지 가능
REQUEST_MAX_RETRIES=4

# PubMed search (PMIDs per ingredient; increase for larger corpora)
SEARCH_LIMIT=50

# PubMed 수집 방식: ingredient(성분별 상위 SEARCH_LIMIT건) | narrow(성분×효능 좁은 검색 후 전부)
PUBMED_COLLECTION_MODE=ingredient
NARROW_PAIRS_CSV=config/pubmed_narrow/tier1_pairs.csv
NARROW_EFFECT_TERMS_CSV=config/pubmed_narrow/effect_terms.csv
NARROW_INGREDIENT_RULES_CSV=config/pubmed_narrow/ingredient_rules.csv
NARROW_FULL_FETCH_MAX=300
NARROW_PAIR_CAP=5000

# Target ingredients list (version-controlled default under config/)
TARGET_CSV_PATH=config/target_ingredients.csv
# Optional: force the path above even when config/target_ingredients.csv exists (rare).
# STRICT_TARGET_CSV=

#Bronze
BRONZE_ROOT_DIR=bronze
BRONZE_DOMAIN_DIR=pubmed
ENABLE_DB_UPSERT=true

#Silver
SILVER_ROOT_DIR=silver
SILVER_DOMAIN_DIR=paper
ENABLE_CHUNK_DB_UPSERT=false

#gold
GOLD_ROOT_DIR=gold
GOLD_DOMAIN_DIR=claim
ENABLE_CLAIM_DB_UPSERT=false

GOLD_TEST_CHUNK_LIMIT=100000
GOLD_DEBUG_PRINT_LIMIT=10

EXTRACTOR_VERSION=llm_claim_extractor_v1
VALIDATOR_VERSION=claim_validator_v1
MAPPING_VERSION=taxonomy_mapping_v1

CHUNK_MAX_CHARS=1000
CHUNK_OVERLAP_CHARS=150
CHUNK_VERSION=abstract_char_window_v1

# Logging
LOG_FORMAT=json
LOG_LEVEL=INFO
